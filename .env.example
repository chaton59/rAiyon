# ---------------------------------------------------------------------------
# rAiyon — exemple de configuration.
#
# Copier en `.env` (`make install` le fait s'il n'existe pas) et remplacer les
# valeurs factices. `.env` est ignoré par git et ne doit jamais être commité.
#
# Toutes les variables portent le préfixe RAIYON_, sauf ANTHROPIC_API_KEY qui
# garde le nom conventionnel attendu par le SDK Anthropic.
# ---------------------------------------------------------------------------

# Clé API Anthropic. OPTIONNELLE depuis l'étape 8 : seules `make chat` et
# `make fumee` appellent un modèle. `make seed`, `make seed-build`, `make calibrer`
# et `make check` n'en ont pas besoin — exiger une clé pour du code déterministe
# serait un mensonge sur la dépendance (PROJET.md, amendement du §5 étape 2).
# Son absence est signalée au moment de l'utiliser, par un message qui dit quoi faire.
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Connexion Postgres. Cette valeur correspond au service `db` de
# docker-compose.yml ; à changer seulement si POSTGRES_PORT est modifié.
RAIYON_DATABASE_URL=postgresql+psycopg://raiyon:raiyon@localhost:5432/raiyon

# Modèles (PROJET.md §3.13).
RAIYON_MODEL_AGENT=claude-sonnet-5
RAIYON_MODEL_EXTRACTION=claude-haiku-4-5-20251001
RAIYON_MODEL_EVAL_CLIENT=claude-haiku-4-5-20251001

# Zone de tolérance budget (PROJET.md §3.10) : 0.15 = +15 %. Bornée à [0, 0.5].
RAIYON_BUDGET_TOLERANCE=0.15

# Garde-fou anti-boucle de la boucle d'agent (PROJET.md §3.9). Minimum 1.
RAIYON_MAX_AGENT_ITERATIONS=8

# Régénérations accordées à un message dont le validateur refuse le texte
# (PROJET.md §3.11 niveau 2). Budget **par tour client**, pas par message.
# 0 est une valeur légitime : elle branche directement le repli sur template, ce
# qui permettra à l'étape 12 de mesurer ce que la régénération rattrape vraiment.
RAIYON_MAX_REGENERATIONS=1

# DEBUG | INFO | WARNING | ERROR
RAIYON_LOG_LEVEL=INFO

# dev | test | prod
RAIYON_APP_ENV=dev

# ---------------------------------------------------------------------------
# Lu par docker-compose.yml uniquement (pas par la configuration Python).
# ---------------------------------------------------------------------------

# Port hôte exposé par Postgres. À changer si 5432 est déjà pris localement —
# penser alors à mettre RAIYON_DATABASE_URL en cohérence.
POSTGRES_PORT=5432
