# ---------------------------------------------------------------------------
# rAiyon — exemple de configuration.
#
# Copier en `.env` (`make install` le fait s'il n'existe pas), puis décommenter
# ANTHROPIC_API_KEY et y mettre la vraie clé. `.env` est ignoré par git et ne doit
# jamais être commité.
#
# Toutes les variables portent le préfixe RAIYON_, sauf ANTHROPIC_API_KEY qui
# garde le nom conventionnel attendu par le SDK Anthropic.
# ---------------------------------------------------------------------------

# Clé API Anthropic. OPTIONNELLE : seules `make chat`, `make api` et `make fumee`
# appellent un modèle. ⚠️ `make api` la réclame au **démarrage** et non
# au premier message : un serveur qui répondrait 200 à /health puis échouerait au
# premier tour dirait son défaut au mauvais moment. `make seed`, `make seed-build`, `make calibrer`
# et `make check` n'en ont pas besoin — exiger une clé pour du code déterministe
# serait un mensonge sur la dépendance (PROJET.md, amendement du §5).
# Son absence est signalée au moment de l'utiliser, par un message qui dit quoi faire.
#
# ⚠️ LAISSER COMMENTÉE. Une valeur factice traverse la garde de `cle_api()` et rend un
# 401 du SDK à la place de ce message ; seule une variable absente le déclenche.
#ANTHROPIC_API_KEY=sk-ant-xxxxx

# Connexion Postgres. Cette valeur correspond au service `db` de
# docker-compose.yml ; à changer seulement si POSTGRES_PORT est modifié.
RAIYON_DATABASE_URL=postgresql+psycopg://raiyon:raiyon@localhost:5432/raiyon

# Version du prompt système en vigueur (PROJET.md §3.14). Nomme un
# fichier de prompts/, sans son extension : systeme.v1, systeme.v2, …
#
# ⚠️ C'est une SÉLECTION DE FICHIER, pas une interpolation. Rien n'entre dans le
# texte du prompt, qui doit rester identique octet pour octet d'un appel à l'autre
# (§3.13, préfixe mis en cache).
#
# Elle décide aussi OÙ ATTERRISSENT LES CASSETTES et le rapport d'éval :
#   systeme.v2 → evals/cassettes/systeme.v2/ et docs/eval/rapport.v2.md
# Lancer une campagne sans elle écrirait dans le jeu de la version par défaut.
RAIYON_PROMPT_SYSTEME=systeme.v2

# Orchestration en vigueur (PROJET.md §5, étape 15) : agent | machine.
#
# ⚠️ AU JALON 0, ELLE N'EST PAS ENCORE CONSOMMÉE par la boucle : il n'existe qu'une
# orchestration. Elle est lue par `make eval-enregistrer`, qui l'inscrit dans l'en-tête
# de chaque cassette produite et refuse d'écrire dans un jeu déjà enregistré sous une
# autre valeur. Ce n'est donc pas un branchement oublié.
RAIYON_ORCHESTRATION=agent

# Modèles (PROJET.md §3.13).
RAIYON_MODEL_AGENT=claude-sonnet-5
RAIYON_MODEL_EXTRACTION=claude-haiku-4-5-20251001
RAIYON_MODEL_EVAL_CLIENT=claude-haiku-4-5-20251001

# Zone de tolérance budget (PROJET.md §3.10) : 0.15 = +15 %. Bornée à [0, 0.5].
RAIYON_BUDGET_TOLERANCE=0.15

# Garde-fou anti-boucle de la boucle d'agent (PROJET.md §3.9). Minimum 1.
RAIYON_MAX_AGENT_ITERATIONS=8

# Régénérations accordées à un message dont le validateur refuse le texte
# (PROJET.md §3.11 niveau 2). Budget **par tour client**, pas par message.
# 0 est une valeur légitime : elle branche directement le repli sur template, ce
# qui mesure ce que la régénération rattrape vraiment.
RAIYON_MAX_REGENERATIONS=1

# DEBUG | INFO | WARNING | ERROR
RAIYON_LOG_LEVEL=INFO

# dev | test | prod
RAIYON_APP_ENV=dev

# ---------------------------------------------------------------------------
# Lu par docker-compose.yml uniquement (pas par la configuration Python).
# ---------------------------------------------------------------------------

# Port hôte exposé par Postgres. À changer si 5432 est déjà pris localement —
# penser alors à mettre RAIYON_DATABASE_URL en cohérence.
POSTGRES_PORT=5432
