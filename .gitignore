.env
# ⚠️ Et toute sauvegarde de .env : un fichier .env.bak porte le même secret et
# n'était PAS ignoré (constaté à l'étape 31, un .env.bak-chevrons traînait non suivi).
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
# Données brutes non versionnées (6,4 Mo), sauf leur traçabilité
data/raw/*
!data/raw/SOURCE.md
!data/raw/CHECKSUMS.sha256
# Journal JSONL d'exploitation (RAIYON_JOURNAL_JSONL)
data/journal/
.DS_Store
